    "inlets": {
      "heating_return_in": "heating_return_pipe.inlet",
      "cooling_return_in": "cooling_return_pipe.inlet",
      "absorption_cooling_in": "absorption_chiller.cooling_in",
      "adsorption_cooling_in": "adsorption_chiller.cooling_in",
      "compression_rejection_in": "compression_chiller.sink_in"

    "outlets": {
      "heating_return_out": "heating_consumer.return_out",
      "cooling_return_out": "cooling_consumer.return_out",
      "gas": "degasser.gas",
      "absorption_cooling_out": "absorption_chiller.cooling_out",
      "adsorption_cooling_out": "adsorption_chiller.cooling_out",
      "compression_rejection_out": "compression_chiller.sink_out"

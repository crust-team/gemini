      },
      {
        "source": "adsorption_chiller.generator_out",
        "target": "heating_supply_pipe.inlet"
      },
      {
        "source": "heating_supply_pipe.outlet",
        "target": "heating_consumer.supply_in"
      },
      {
        "source": "cooling_return_pipe.outlet",
        "target": "absorption_chiller.chilled_in"
      },
      {
        "source": "absorption_chiller.chilled_out",
        "target": "adsorption_chiller.chilled_in"
      },
      {
        "source": "adsorption_chiller.chilled_out",
        "target": "compression_chiller.source_in"
      },
      {
        "source": "compression_chiller.source_out",
        "target": "cooling_supply_pipe.inlet"
      },
      {
        "source": "cooling_supply_pipe.outlet",
        "target": "cooling_consumer.supply_in"
      },
      {
        "source": "heat_exchanger.cold_out",
        "target": "peak_boiler.inlet"
      },
      {
        "source": "heat_exchanger.hot_out",
        "target": "filters.cold.inlet"

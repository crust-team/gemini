{
  "format": 2,
  "name": "DistrictNetwork",
  "modules": {
    "pump": {
      "type": "CentrifugalPump",
      "params": {}
    },
    "supply_pipe": {
      "type": "Pipe",
      "params": {}
    },
    "splitters": {
      "type": "ModuleList",
      "modules": {
        "0": {
          "type": "Splitter",
          "params": {}
        }
      }
    },
    "substations": {
      "type": "ModuleList",
      "modules": {
        "0": {
          "type": "HeatingSubstation",
          "params": {}
        },
        "1": {
          "type": "HeatingSubstation",
          "params": {}
        }
      }
    },
    "mixers": {
      "type": "ModuleList",
      "modules": {
        "0": {
          "type": "Mixer",
          "params": {}
        }
      }
    },
    "return_pipe": {
      "type": "Pipe",
      "params": {}
    }
  },
  "connections": [
    {
      "source": "pump.fluid_out",
      "target": "supply_pipe.fluid_in"
    },
    {
      "source": "supply_pipe.fluid_out",
      "target": "splitters.0.fluid_in"
    },
    {
      "source": "splitters.0.branch2_out",
      "target": "substations.0.supply_in"
    },
    {
      "source": "splitters.0.branch1_out",
      "target": "substations.1.supply_in"
    },
    {
      "source": "substations.0.return_out",
      "target": "mixers.0.branch1_in"
    },
    {
      "source": "substations.1.return_out",
      "target": "mixers.0.branch2_in"
    },
    {
      "source": "mixers.0.fluid_out",
      "target": "return_pipe.fluid_in"
    }
  ],
  "inlets": {
    "supply_in": "pump.fluid_in"
  },
  "outlets": {
    "return_out": "return_pipe.fluid_out"
  },
  "outputs": {
    "heat_supplied": {
      "sum": "heat_supplied"
    },
    "heat_absorbed": {
      "sum": "heat_absorbed"
    },
    "heat_loss": {
      "sum": "heat_loss"
    },
    "electricity": {
      "sum": "electricity"
    },
    "return_out_T": {
      "of": "return_pipe.fluid_out_T"
    }
  },
  "bindings": {},
  "param_history": {}
}

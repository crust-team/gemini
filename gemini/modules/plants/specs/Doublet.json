{
  "format": 2,
  "name": "Doublet",
  "modules": {
    "reservoir": {"type": "ProductionReservoir", "params": {}},
    "well": {"type": "ProductionWell", "params": {}},
    "esp": {"type": "ESP", "params": {}},
    "riser": {"type": "ProductionWell", "params": {}},
    "injector": {"type": "InjectionWell", "params": {}},
    "sink": {"type": "InjectionReservoir", "params": {}}
  },
  "connections": [
    {"source": "injector.bottom_out", "target": "sink.sandface_in"},
    {"source": "reservoir.sandface_out", "target": "well.bottom_in"},
    {"source": "well.wellhead_out", "target": "esp.fluid_in"},
    {"source": "esp.fluid_out", "target": "riser.bottom_in"}
  ],
  "inlets": {"return_in": "injector.wellhead_in"},
  "outlets": {"supply_out": "riser.wellhead_out"},
  "outputs": {
    "electricity": {"sum": "electricity"},
    "heat_loss": {"sum": "heat_loss"},
    "flow": {"of": "reservoir.liquid_flow"},
    "production_temperature": {"of": "riser.wellhead_temperature"},
    "injection_temperature": {"of": "injector.wellhead_temperature"},
    "brine_cooling": {"difference": ["production_temperature", "injection_temperature"]}
  },
  "bindings": {},
  "param_history": {}
}

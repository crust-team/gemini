      "description": "Adsorption chiller driven by the hot water; false leaves the unit out."
    },
    "compression_chiller.enabled": {
      "default": true,
      "unit": null,
      "description": "Compression chiller (heat pump in cooling mode); false leaves the unit out."
    },
    "cooling_loop.enabled": {
      "default": true,
      "unit": null,

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GEMINI error",
  "description": "GeminiError.to_dict(): the shape of 422 details and agent tool results. code is one of gm.errors.CODES.",
  "type": "object",
  "required": ["class", "message", "path", "code", "suggestions"],
  "additionalProperties": false,
  "properties": {
    "class": {"type": "string"},
    "message": {"type": "string"},
    "path": {"type": ["string", "null"]},
    "code": {"type": "string"},
    "suggestions": {"type": "array", "items": {"type": "string"}}
  }
}

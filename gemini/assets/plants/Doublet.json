{
  "format": 2,
  "name": "Doublet",
  "modules": {
    "reservoir": {
      "type": "ProductionReservoir",
      "params": {}
    },
    "well": {
      "type": "ProductionWell",
      "params": {}
    },
    "esp": {
      "type": "ESP",
      "params": {}
    },
    "riser": {
      "type": "ProductionWell",
      "params": {}
    },
    "injector": {
      "type": "InjectionWell",
      "params": {}
    },
    "sink": {
      "type": "InjectionReservoir",
      "params": {}
    },
    "formation": {
      "type": "Formation",
      "params": {}
    }
  },
  "connections": [
    {
      "source": "injector.bottom_out",
      "target": "sink.sandface_in"
    },
    {
      "source": "reservoir.sandface_out",
      "target": "well.bottom_in"
    },
    {
      "source": "well.wellhead_out",
      "target": "esp.fluid_in"
    },
    {
      "source": "esp.fluid_out",
      "target": "riser.bottom_in"
    },
    {
      "source": "well.loss_out",
      "target": "formation.heat_in"
    },
    {
      "source": "riser.loss_out",
      "target": "formation.heat_in"
    },
    {
      "source": "injector.loss_out",
      "target": "formation.heat_in"
    }
  ],
  "inlets": {
    "return_in": "injector.wellhead_in",
    "power_in": "esp.power_in"
  },
  "outlets": {
    "supply_out": "riser.wellhead_out"
  },
  "outputs": {
    "brine_cooling": {
      "difference": [
        "riser.wellhead_out.T",
        "injector.wellhead_in.T"
      ]
    }
  },
  "bindings": {},
  "param_history": {}
}

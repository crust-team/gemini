{
  "demand": {
    "file": "demand.csv",
    "columns": {
      "heat_kw": "heating_demand",
      "cool_kw": "cooling_demand"
    },
    "unit": "kW",
    "time_column": "timestamp"
  },
  "site": {
    "d*.gradient": "36 K/km",
    "d*.surface_temperature": "9 degC",
    "d*.thickness": "60 m",
    "d*.permeability": "450 mD",
    "d*.reservoir.pressure": "120 barg",
    "d*.sink.pressure": "120 barg"
  },
  "constraints": [
    {
      "path": "d*.reservoir.liquid_flow",
      "min": "35 m3/h",
      "max": "180 m3/h",
      "when": "running"
    },
    {
      "path": "d*.brine_cooling",
      "max": "22 K",
      "when": "running"
    },
    {
      "path": "d*.reservoir.liquid_flow",
      "max": "450 h",
      "over": "duration",
      "when": "running"
    },
    {
      "path": "d*.pump_efficiency",
      "min": 0.6,
      "max": 0.68
    },
    {
      "path": "d*.volume_imbalance",
      "min": "-1e-5 m3/s",
      "max": "1e-5 m3/s",
      "when": "running"
    },
    {
      "path": "heating_consumer.supply_in.temperature",
      "min": "65 degC",
      "when": "running"
    },
    {
      "path": "cooling_consumer.supply_in.temperature",
      "max": "16 degC",
      "when": "running"
    }
  ],
  "assumptions": {
    "discount_rate": 0.04,
    "lifetime_years": 30,
    "electricity_emission_factor": 1e-07,
    "prices": {
      "electricity": "120 EUR/MWh",
      "gas": "55 EUR/MWh"
    }
  }
}

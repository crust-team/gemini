{
  "$defs": {
    "bindings": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "column": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "column",
              "unit"
            ],
            "type": "object"
          }
        ]
      },
      "description": "Flat bindings of one module: a control, boundary, measured output or state name, or port.field of an inlet, to a column name or {column, unit}.",
      "type": "object"
    },
    "module": {
      "additionalProperties": false,
      "properties": {
        "modules": {
          "additionalProperties": {
            "$ref": "#/$defs/module"
          },
          "type": "object"
        },
        "params": {
          "type": "object"
        },
        "type": {
          "enum": [
            "ATESPlant",
            "AbsorptionUnit",
            "AdsorptionChiller",
            "AquiferStorage",
            "Atmosphere",
            "Blowdown",
            "Boiler",
            "BoilerChpPlant",
            "BoreholeField",
            "CHP",
            "CentrifugalPump",
            "ChemicalGrid",
            "Cooler",
            "CoolingGrid",
            "CoolingSubstation",
            "Degasser",
            "Desander",
            "DistrictEnergyPlant",
            "DistrictNetwork",
            "Doublet",
            "DoubletHeatPlant",
            "DownholeHeatExchanger",
            "ESP",
            "ElectricBoiler",
            "ElectricityGrid",
            "Filter",
            "Flare",
            "FlashTurbine",
            "Formation",
            "GasCompressor",
            "GasGrid",
            "GasMakeup",
            "HackathonPlant",
            "HeatExchanger",
            "HeatPump",
            "HeatingGrid",
            "HeatingSubstation",
            "IceStorage",
            "InhibitorDosing",
            "InjectionPump",
            "InjectionReservoir",
            "InjectionWell",
            "LineShaftPump",
            "Mixer",
            "MultiWellPlant",
            "NodalDoublet",
            "ORC",
            "PIDController",
            "ParallelExchangerPlant",
            "Pipe",
            "PressurizationTank",
            "ProductionReservoir",
            "ProductionWell",
            "Separator",
            "Splitter",
            "ThermalDecline",
            "ThermalStorage",
            "Valve",
            "WasteGrid",
            "ModuleDict",
            "ModuleList"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "additionalProperties": {
        "$ref": "#/$defs/bindings"
      },
      "type": "object"
    },
    "boundary": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "connections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "source": {
            "pattern": "^[^.\\s]+(\\.[^.\\s]+)+$",
            "type": "string"
          },
          "target": {
            "pattern": "^[^.\\s]+(\\.[^.\\s]+)+$",
            "type": "string"
          },
          "type": {
            "enum": [
              "state",
              null
            ]
          }
        },
        "required": [
          "source",
          "target"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "fluids": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "format": {
      "const": 2
    },
    "inlets": {
      "additionalProperties": {
        "anyOf": [
          {
            "pattern": "^[^.\\s]+(\\.[^.\\s]+)+$",
            "type": "string"
          },
          {
            "items": {
              "pattern": "^[^.\\s]+(\\.[^.\\s]+)+$",
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "type": "object"
    },
    "modules": {
      "additionalProperties": {
        "$ref": "#/$defs/module"
      },
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "outlets": {
      "additionalProperties": {
        "anyOf": [
          {
            "pattern": "^[^.\\s]+(\\.[^.\\s]+)+$",
            "type": "string"
          },
          {
            "items": {
              "pattern": "^[^.\\s]+(\\.[^.\\s]+)+$",
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "type": "object"
    },
    "outputs": {
      "additionalProperties": {
        "additionalProperties": false,
        "maxProperties": 2,
        "minProperties": 1,
        "properties": {
          "difference": {
            "items": {
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "field": {
            "type": "string"
          },
          "of": {
            "pattern": "^[^.\\s]+(\\.[^.\\s]+)+$",
            "type": "string"
          },
          "ratio": {
            "items": {
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "sum": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "object"
    },
    "param_history": {
      "additionalProperties": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "type": "object"
    }
  },
  "required": [
    "format",
    "name",
    "modules",
    "connections",
    "bindings",
    "param_history"
  ],
  "title": "GEMINI plant spec",
  "type": "object"
}

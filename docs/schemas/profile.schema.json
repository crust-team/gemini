{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "columns": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "unit",
          "quantity"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "description": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "source": {
      "description": "Where the data comes from.",
      "type": "string"
    },
    "time": {
      "items": {
        "format": "date-time",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "values": {
      "additionalProperties": {
        "items": {
          "type": [
            "number",
            "null"
          ]
        },
        "type": "array"
      },
      "type": "object"
    }
  },
  "required": [
    "name",
    "description",
    "source",
    "columns",
    "time",
    "values"
  ],
  "title": "Demand profile",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GEMINI results summary",
  "description": "Results.summary(path=None, start=None, end=None): {min, max, mean} per numeric field of each module path, each a value. A field with no finite value has null values with a reason.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": {
      "type": "object",
      "required": [
        "min",
        "max",
        "mean"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "$ref": "#/$defs/value"
        },
        "max": {
          "$ref": "#/$defs/value"
        },
        "mean": {
          "$ref": "#/$defs/value"
        }
      }
    }
  },
  "$defs": {
    "value": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
